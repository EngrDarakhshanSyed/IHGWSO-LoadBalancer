	    private Map<Cloudlet, VMToUsage> initializeRandomPosition() {
	    	// Local mapping
	        Map<Cloudlet, VMToUsage> position = new HashMap<>();
	        Random random = new Random();
	        for (Cloudlet cloudlet : cloudlets) {
	        	Vm vm = vms.get(random.nextInt(vms.size()));
	        	VMToUsage vmusage = null;
	        	if (position.size() > 0) {
	        		for (Map.Entry<Cloudlet, VMToUsage> entry: position.entrySet()) {
	        			VMToUsage vmtousage = entry.getValue();
	        			if (vmtousage.vm.getId() == vm.getId()) {
	        				vmusage = vmtousage;
	        				break;
	        			}
	        		}
	        	}
	        	if (vmusage == null) {
	        		vmusage = new VMToUsage(vm);
	        	}
	        	vmusage.attachCloudlet(cloudlet.getCloudletLength());
	        	position.put(cloudlet, vmusage);
	        }
	        return position;
	    }
	    
