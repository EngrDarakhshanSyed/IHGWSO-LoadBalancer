	    public void distributeCloudlets() {
	        // Get the list of VMs
	        Map<Vm, Integer> vmCount = new HashMap<>();

	        for (VMToUsage vm : position2.values()) {
	            vmCount.put(vm.vm, vmCount.getOrDefault(vm.vm, 0) + 1);
	        }
	        
	        for (Map.Entry<Vm, Integer> entry : vmCount.entrySet()) {
	        	Log.printLine("VM Count: " + entry.getValue());
	        }

	        // Calculate the average number of Cloudlets per VM
	        int averageCloudletsPerVm = position2.size() / vmCount.size();

	        int loop = 0;
	        // Distribute Cloudlets equally among VMs
	        for (Map.Entry<Cloudlet, VMToUsage> entry : position2.entrySet()) {
	        	Cloudlet cloudlet = entry.getKey();
	            VMToUsage vm = entry.getValue();
	            
	            // Check if the VM exceeds the average number of Cloudlets
	            if (vmCount.get(vm.vm) > averageCloudletsPerVm) {
	                // Find a VM with fewer Cloudlets and assign the Cloudlet to it
	                for (VMToUsage otherVm : position2.values()) {
	                    if (vmCount.get(otherVm.vm) < averageCloudletsPerVm) {
	                        position2.put(cloudlet, otherVm);
	                        vmCount.put(vm.vm, vmCount.get(vm.vm) - 1);
	                        vmCount.put(otherVm.vm, vmCount.get(otherVm.vm) + 1);
	                        break;
	                    }
	                }	
	            }
	        }
	        
	        
	        for (Map.Entry<Vm, Integer> entry : vmCount.entrySet()) {
	        	Log.printLine("2. VM Count: " + entry.getValue());
	        }
	    }
	       
	    public void distributeCloudlets2() {
	        // Get the list of VMs and calculate total cloudlet length for each VM
	        Map<Vm, Integer> vmCloudletLength = new HashMap<>();

	        for (Map.Entry<Cloudlet, VMToUsage> entry : position2.entrySet()) {
	        	Cloudlet cloudlet = entry.getKey();
	            VMToUsage vm = entry.getValue();

	            long cloudletLength = cloudlet.getCloudletLength();
	            vmCloudletLength.put(vm.vm, (int) (vmCloudletLength.getOrDefault(vm, 0) + cloudletLength));
	        }

	        // Calculate the average Cloudlet length per VM
	        Map<Vm, Double> averageCloudletLengthPerVm = new HashMap<>();
	        for (Vm vm : vmCloudletLength.keySet()) {
	            int totalCloudletLength = vmCloudletLength.get(vm);
	            double averageLength = (double) totalCloudletLength / position2.size(); // Use position size instead of vmCloudletCount
	            averageCloudletLengthPerVm.put(vm, averageLength);
	        }

	        // Distribute Cloudlets based on average Cloudlet length
	        for (Map.Entry<Cloudlet, VMToUsage> entry : position2.entrySet()) {
	        	Cloudlet cloudlet = entry.getKey();
	            VMToUsage vm = entry.getValue();

	            double cloudletLength = cloudlet.getCloudletLength();
	            double averageLength = averageCloudletLengthPerVm.get(vm.vm);

	            // Check if the VM exceeds the average Cloudlet length
	            if (cloudletLength > averageLength) {
	                // Find a VM with shorter average Cloudlet length and assign the Cloudlet to it
	                for (VMToUsage otherVm : position2.values()) {
	                    if (averageCloudletLengthPerVm.get(otherVm.vm) < averageLength) {
	                        position2.put(cloudlet, otherVm);
	                        vmCloudletLength.put(vm.vm, vmCloudletLength.get(vm.vm) - (int) cloudletLength);
	                        vmCloudletLength.put(otherVm.vm, vmCloudletLength.get(otherVm.vm) + (int) cloudletLength);
	                        break;
	                    }
	                }
	            }
	        }
	    }
	    
	    
