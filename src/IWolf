	    public void calculateFitness(List<Cloudlet> cloudlets, List<Vm> vms) {
	    	double loadImbalanceFitness = calculateLoadImbalanceFitness(cloudlets, vms);
	    	double responseTimeFitness = calculateResponseTimeFitness(cloudlets, vms);
	    	double resourceDistributionFitness = calculateResourceDistributionVMFitness(vms);
	        //double MakespanFitness =  calculateMakespanFitness(cloudlets, vms);

	        // You can define a weighted combination of the above fitness components
	        // based on the importance of each factor to your load balancing objectives
	      double   weightLoadImbalance = 0.1;  // Adjust weights based on importance
	       double weightResponseTime = 0.8;
	       double weightResourceDistribution = 0.1;
	       // double weightMakespanFitness = 0.2;

	        // Combine the fitness components using weighted sum
	       this.fitness = weightLoadImbalance * loadImbalanceFitness +
	                  weightResponseTime * responseTimeFitness +
	                  weightResourceDistribution * resourceDistributionFitness;
	   
	    }
	    

	    public double calculateLoadImbalanceFitness(List<Cloudlet> cloudlets, List<Vm> vms) {
	        // Calculate the load on each VM based on the assigned cloudlets
	        double[] vmLoad = new double[vms.size()];
	        
	        for (Cloudlet cloudlet : cloudlets) {
	            //int assignedVmId = cloudlet.getVmId(); // Tada: review with DK
	        	int assignedVmId = position2.get(cloudlet).vm.getId();
	        	
	            double cloudletLength = cloudlet.getCloudletLength();
	            
	            // Add the length of the cloudlet to the load of the assigned VM
	            vmLoad[assignedVmId] += cloudletLength;
	        }
	        
	        // Calculate load imbalance as the standard deviation of VM loads
	        double loadImbalance = calculateStandardDeviation(vmLoad);
	        
	        // Normalize the load imbalance to obtain a fitness value (lower values are better)
	        double fitness = 1.0 / (1.0 + loadImbalance);
	        
	        return fitness;
	    }

	    private double calculateStandardDeviation(double[] values) {
	        // Calculate the standard deviation of an array of values
	        double sum = 0.0;
	        double mean = calculateMean(values);
	        
	        for (double value : values) {
	            sum += Math.pow(value - mean, 2);
	        }
	        
	        double variance = sum / values.length;
	        return Math.sqrt(variance);
	    }

	    private double calculateMean(double[] values) {
	        // Calculate the mean (average) of an array of values
	        double sum = 0.0;
	        
	        for (double value : values) {
	            sum += value;
	        }
	        
	        return sum / values.length;
	    }
	        
	    
	    
