	    private double calculateSingleResponseTime(Cloudlet cloudlet, Vm vm) {
	        // Implement logic to calculate the response time for a cloudlet on a VM
	        // You can use various factors like cloudlet length, VM's processing power, etc.
	        double cloudletLength = cloudlet.getCloudletLength();
	        double vmMips = vm.getMips();
	        
	        // Calculate response time (for example, using the formula: responseTime = cloudletLength / vmMips)
	        double responseTime = cloudletLength / vmMips;
	        return responseTime;
	    }

	    // Define a method to calculate average response time for all cloudlets on all VMs
	    private double calculateAverageResponseTime(List<Cloudlet> cloudlets, List<Vm> vms) {
	        double totalResponseTime = 0.0;
	        int totalCloudlets = cloudlets.size();

	        for (Cloudlet cloudlet : cloudlets) {
	            // Find the VM to which the cloudlet is assigned
	            //int vmId = cloudlet.getVmId(); // Tada:
	        	int vmId = position2.get(cloudlet).vm.getId();
	            Vm vm = vms.get(vmId);

	            // Calculate response time for the cloudlet on the VM
	            double responseTime = calculateSingleResponseTime(cloudlet, vm);
	            totalResponseTime += responseTime;
	        }

	        // Calculate average response time
	        double averageResponseTime = totalResponseTime / totalCloudlets;
	        return averageResponseTime;
	    }

	    // Define the fitness function that evaluates load balancing based on response time
	    public double calculateResponseTimeFitness(List<Cloudlet> cloudlets, List<Vm> vms) {
	        // Calculate the average response time for all cloudlets on all VMs
	        double averageResponseTime = calculateAverageResponseTime(cloudlets, vms);

	        // Define your fitness criteria based on response time
	        // You can use different objectives, such as minimizing or maximizing response time
	        // For this example, let's aim to minimize response time
	        double fitness = 1.0 / (1.0 + averageResponseTime);

	        return fitness;
	    }
