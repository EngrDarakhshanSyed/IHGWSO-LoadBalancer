	 // Helper method to calculate resource distribution fitness based on an array of utilization values
	    private double calculateResourceDistributionFitness(double[] utilizationValues) {
	    	double mean = calculateMean(utilizationValues);
	        double sumSquaredDifferences = 0.0;
	        
	        for (double utilization : utilizationValues) {
	            double difference = utilization - mean;
	            sumSquaredDifferences += difference * difference;
	        }
	        
	        double variance = sumSquaredDifferences / utilizationValues.length;
	        double standardDeviation = Math.sqrt(variance);
	        
	        // The lower the standard deviation, the better the resource distribution
	        // Normalize the fitness value to be higher when standardDeviation is lower
	        // Add 1.0 to avoid division by zero and ensure higher fitness values are better;
	        double ret = 1.0 / (1.0 + standardDeviation); 
	        return ret;
	    }
	    
	    private double calculateResourceDistributionFitnessMem(double[] utilizationValues) {
	    	double mean = calculateMean(utilizationValues);
	        double sumSquaredDifferences = 0.0;
	        
	        for (double utilization : utilizationValues) {
	            double difference = utilization - mean;
	            sumSquaredDifferences += difference * difference;
	        }
	        
	        double variance = sumSquaredDifferences / utilizationValues.length;
	        double standardDeviation = Math.sqrt(variance);
	        
	        // The lower the standard deviation, the better the resource distribution
	        // Normalize the fitness value to be higher when standardDeviation is lower
	        // Add 1.0 to avoid division by zero and ensure higher fitness values are better;
	        double ret = 1.0 / (1.0 + standardDeviation); 
	        return ret;
	    }
	    
	    // Helper method to calculate the variance of an array of values
	    private double calculateVariance(double[] values) {
	        double mean = calculateMean(values);
	        double sumOfSquares = 0.0;

	        for (double value : values) {
	            sumOfSquares += Math.pow(value - mean, 2);
	        }

	        return sumOfSquares / (values.length - 1); // Use (n-1) for sample variance
	    }

