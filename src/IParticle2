    public IParticle2(List<Cloudlet> cloudlets, List<Vm> vms) {
        this.position = initializeRandomPosition(cloudlets, vms);
        this.velocity = initializeRandomVelocity(cloudlets, vms);
        this.bestPosition = new HashMap<>(this.position); // Initially, the best position is the same as the starting position.
        
        Map<Cloudlet, Double> precomputedProcessingTime = new HashMap<>();
        
        for (Map.Entry<Cloudlet, VMToUsage> entry : this.position.entrySet()) {
            Cloudlet cloudlet = entry.getKey();
            Vm vm = entry.getValue().getVM();

            try {
                double baseProcessing = getProcessingTime(cloudlet, vm); // only once
                precomputedProcessingTime.put(cloudlet, baseProcessing);
            } catch (Exception e) {
                Log.printLine("Precomputation error: " + e.getMessage());
            }
        }
        
        Map<Cloudlet, Double> preResponseTimeFitness = new HashMap<>();
        for (Map.Entry<Cloudlet, VMToUsage> entry : this.position.entrySet()) {
            Cloudlet cloudlet = entry.getKey();
            VMToUsage vm = entry.getValue();

            try {
                double baseProcessing = calculateResponseTimeFitness(cloudlet, vm, cloudlets); // only once
                preResponseTimeFitness.put(cloudlet, baseProcessing);
            } catch (Exception e) {
                Log.printLine("Precomputation error: " + e.getMessage());
            }
        }
        
        fitness = computeFitness(position, cloudlets, vms, precomputedProcessingTime, preResponseTimeFitness);
        bestFitness = fitness;
    
    
    }
    


    private Map<Cloudlet, VMToUsage> initializeRandomPosition(List<Cloudlet> cloudlets, List<Vm> vms) {
        Map<Cloudlet, VMToUsage> position = new HashMap<>();
       // Particle particle = wolfInstance.new Particle();
        Random random = new Random();
        for (Cloudlet cloudlet : cloudlets) {
            Vm selectedVm = vms.get(random.nextInt(vms.size()));
            VMToUsage vmUsage = position.getOrDefault(cloudlet, new VMToUsage(selectedVm));
            vmUsage.attachCloudlet(cloudlet.getCloudletLength());
            position.put(cloudlet, vmUsage);
           // Log.printLine("Position: " + cloudlet.getCloudletId() + " => " + vmUsage.vm.getId());
        }
        return position;
    }
    
    private Map<Cloudlet, VMToUsage> initializeRandomVelocity(List<Cloudlet> cloudlets, List<Vm> vms) {
        Map<Cloudlet, VMToUsage> velocity = new HashMap<>();
        Random random = new Random();
        for (Cloudlet cloudlet : cloudlets) {
            Vm selectedVm = vms.get(random.nextInt(vms.size()));
            VMToUsage vmUsage = new VMToUsage(selectedVm);
            vmUsage.attachCloudlet(cloudlet.getCloudletLength());
            velocity.put(cloudlet, vmUsage);
         //   Log.printLine("Velocity: " + cloudlet.getCloudletId() + " => " + vmUsage.vm.getId());
        }
        return velocity;
    }
    

    
    public double computeFitness(Map<Cloudlet, VMToUsage> position, List<Cloudlet> cloudlets, 
    		List<Vm> vms, Map<Cloudlet, Double> precomputedProcessingTime,
    		Map<Cloudlet, Double> preResponseTimeFitness) {
        double makespan = 0;
        double throughput = 0;
        double totalResponseTime = 0;

        double totalProcessingTime = 0;
        Random rand = new Random();
        double processingTime = 0;
        double responseTimeFitness = 0;
        

        for (Map.Entry<Cloudlet, VMToUsage> entry : position.entrySet()) {
            Cloudlet cloudlet = entry.getKey();
            VMToUsage vmUsage = entry.getValue();

            try {
	            // Introduce randomness in the processing time calculation
            	//double randomfactor = 0.8 + 0.4 * rand.nextDouble();
	            processingTime = precomputedProcessingTime.get(cloudlet) * (0.8 + 0.4 * rand.nextDouble());
	            responseTimeFitness = preResponseTimeFitness.get(cloudlet) * (0.8 + 0.4 * rand.nextDouble());//calculateResponseTimeFitness(cloudlet, vmUsage, cloudlets) * randomfactor;
            } catch (Exception ex) {
            	Log.printLine(ex.getMessage());
            	Log.printLine(ex.getStackTrace()[0].getLineNumber());
            	System.exit(-2);
            }
            totalProcessingTime += processingTime;
            totalResponseTime += responseTimeFitness;
            makespan = Math.max(makespan, processingTime);
        }

       throughput = cloudlets.size() / totalProcessingTime;

        // Weight the objectives based on importance
        double w1 = 0.3;
        double w2 = 0.3;
        double w3 = 0.4;
        
        double fitnessValue = w1 * makespan + w2 * (1/throughput) + w3 * totalResponseTime;
        //Log.printLine("Each particle => [" + fitnessValue + "] = " + w1 + " * " + makespan + " + " + w2 + " * " + throughput + " + " + w3 + " * " + totalResponseTime);
        
        return fitnessValue;
    }

    private double getProcessingTime(Cloudlet cloudlet, Vm vm) {
        try {
            if (vm.getMips() <= 0) {
                return Double.MAX_VALUE;
            }
        } catch(Exception e) {
            Log.print("Exception " + e.toString());
        }

        return cloudlet.getCloudletLength() / vm.getMips();
    }

    private double calculateResponseTimeFitness(Cloudlet cloudlet, VMToUsage vm, List<Cloudlet> allCloudlets) {
        
    	double dataTransferTime = cloudlet.getCloudletFileSize() / Math.max(1.0, vm.getVM().getBw());
        double vmCurrentEndTime = getVmCurrentEndTime(vm, allCloudlets);
        double waitingTime = Math.max(0, vmCurrentEndTime - cloudlet.getSubmissionTime());
        
        return dataTransferTime + waitingTime;
    } 
    
    
    
    
    
    
