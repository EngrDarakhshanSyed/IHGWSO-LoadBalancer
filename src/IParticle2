    private double getVmCurrentEndTime(VMToUsage vm, List<Cloudlet> allCloudlets) {
        List<Cloudlet> assignedCloudlets = getCloudletsAssignedToVm(vm, allCloudlets);

        // Compute the total processing time of all cloudlets assigned to this VM
        double totalProcessingTime = assignedCloudlets.stream()
                .mapToDouble(cloudlet -> getProcessingTime(cloudlet, vm.getVM()))
                .sum();

        return totalProcessingTime;
    }
    
    private List<Cloudlet> getCloudletsAssignedToVm(VMToUsage vm, List<Cloudlet> allCloudlets) {
        // Assuming a method `getCloudletList()` that gives you all cloudlets

        // Filter out the cloudlets that are assigned to the given VM
        return allCloudlets.stream()
                           .filter(cloudlet -> cloudlet.getVmId() == vm.getVM().getId())
                           .collect(Collectors.toList());
    }
    
    class SaveCloudlet {
    	List<Cloudlet> cloudlets;
    	double total_mips = 0.0;
    	public SaveCloudlet() {
    		this.cloudlets = new LinkedList<Cloudlet>();
    	}
    	
    	public void addCloudlet(Cloudlet cloudlet) {
    		this.cloudlets.add(cloudlet);
    	}
    	
    	@Override
    	public String toString() {
    		String str = "";
    		total_mips = 0.0;
    		for (Cloudlet cloudlet : this.cloudlets) {
    			str += "("+cloudlet.getCloudletId()+", "+cloudlet.getCloudletLength()+")";
    			total_mips += cloudlet.getCloudletLength();
    		}
    		str += " " + total_mips;
    		return str;
    	}
    	
    	double getTotal() {
    		return total_mips;
    	}
    	
    }
    
    public void printCloudletVmFitnessEffi() {
    	
    	Map<Vm, SaveCloudlet> maplist = new HashMap<Vm, SaveCloudlet>();
    	for (Map.Entry<Cloudlet, VMToUsage> entry : position.entrySet()) {
    		Cloudlet key = entry.getKey();
    		VMToUsage v = entry.getValue();
    		Vm value = v.vm;
    		if (maplist.containsKey(value)) {
    			SaveCloudlet sc = maplist.get(value);
    			sc.addCloudlet(key);
    			maplist.put(value, sc);
    		} else {
    			SaveCloudlet sc = new SaveCloudlet();
    			sc.addCloudlet(key);
    			maplist.put(value, sc);
    		}
    	}
    	

    	
    	double total_time2 = 0.0;
    	for (Map.Entry<Vm, SaveCloudlet> entry: maplist.entrySet()) {
    		Vm key = entry.getKey();
    		SaveCloudlet value = entry.getValue();
    		Log.printLine("IParticle Vm: " + key.getId() + " <=> " + key.getMips() +  " ====>  " + value + " (" + (value.getTotal()/key.getMips()) +" seconds ) ");
    		total_time2 += (value.getTotal()/key.getMips());
    	}
    	Log.printLine("Total Time: " + total_time2);
    }
